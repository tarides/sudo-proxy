#!/bin/sh
# Test stand-in for sudo (tests/pty_e2e.rs). The daemon spawns
# `sudo [-u USER] K=V... -- argv`; the pty harness names this file with
# `--sudo-path` (the daemon never looks `sudo` up on its PATH, GHSA-gx9w-4f7x-2gcp).
# Log the argv exactly as received, then
# run the command as the invoking user. Nothing is ever escalated.
#
# The daemon runs sudo with a cleared environment (TERM, LANG and LC_* only),
# so the log cannot be named by a variable: the harness copies this file into
# its temp directory, and the log is `sudo.log` next to the copy. The
# environment sudo received is written to `sudo.env` (last call wins), with the
# `export -p` builtin since PATH is unset here.
#
# Log format: one record per invocation, each argument NUL-terminated, then a
# newline. Argv cannot contain a newline (the daemon rejects one), so records
# never split. Records come from sequential leaves; concurrent pipeline stages
# could interleave the two writes below.
set -eu
here=${0%/*}
{ printf '%s\000' "$@"; printf '\n'; } >>"$here/sudo.log"
export -p >"$here/sudo.env"

if [ "${1-}" = "-u" ]; then
    shift 2
fi

# Like sudo: the K=V words before the first `--` set the environment, and
# everything after it is the command, taken literally (an argv[0] containing
# `=` stays a command, which `env K=V cmd` would not guarantee). The daemon
# only emits valid names here (HOME/USER/LOGNAME/PATH and the setenv
# allowlist).
while [ $# -gt 0 ]; do
    a=$1
    shift
    if [ "$a" = "--" ]; then
        break
    fi
    export "$a"
done
exec "$@"
