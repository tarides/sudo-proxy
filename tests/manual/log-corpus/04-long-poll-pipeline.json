{
  "op": "seq",
  "steps": [
    {
      "op": "exec",
      "argv": [
        "sleep",
        "480"
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== PIPELINE_DONE present? ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "grep",
        "-c",
        "PIPELINE_DONE",
        "/tmp/tsan_pipeline.log"
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== tail ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "tail",
        "-6",
        "/tmp/tsan_pipeline.log"
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== still running? ==="
      ]
    },
    {
      "op": "alt",
      "steps": [
        {
          "op": "pipe",
          "stages": [
            {
              "op": "exec",
              "argv": [
                "pgrep",
                "-af",
                "opam|dune build|make"
              ]
            },
            {
              "op": "exec",
              "argv": [
                "grep",
                "-v",
                "pgrep"
              ]
            },
            {
              "op": "exec",
              "argv": [
                "head",
                "-3"
              ]
            }
          ]
        },
        {
          "op": "exec",
          "argv": [
            "echo",
            "no build procs"
          ]
        }
      ]
    }
  ]
}
