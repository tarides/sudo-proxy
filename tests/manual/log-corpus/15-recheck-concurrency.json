{
  "op": "seq",
  "steps": [
    {
      "op": "alt",
      "steps": [
        {
          "op": "pipe",
          "stages": [
            {
              "op": "exec",
              "argv": [
                "pgrep",
                "-af",
                "concurrency.exe"
              ]
            },
            {
              "op": "exec",
              "argv": [
                "grep",
                "-v",
                "pgrep"
              ]
            }
          ]
        },
        {
          "op": "exec",
          "argv": [
            "echo",
            "no concurrency proc"
          ]
        }
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== warnings ==="
      ]
    },
    {
      "op": "redirect",
      "stream": "stderr",
      "target": {
        "to": "dev-null"
      },
      "do": {
        "op": "exec",
        "argv": [
          "grep",
          "-cE",
          "WARNING: ThreadSanitizer",
          "/tmp/tsan_conc.log"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== OK count ==="
      ]
    },
    {
      "op": "redirect",
      "stream": "stderr",
      "target": {
        "to": "dev-null"
      },
      "do": {
        "op": "exec",
        "argv": [
          "grep",
          "-c",
          "OK",
          "/tmp/tsan_conc.log"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== tail ==="
      ]
    },
    {
      "op": "redirect",
      "stream": "stderr",
      "target": {
        "to": "dev-null"
      },
      "do": {
        "op": "exec",
        "argv": [
          "tail",
          "-6",
          "/tmp/tsan_conc.log"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== mmap_rnd_bits ==="
      ]
    },
    {
      "op": "alt",
      "steps": [
        {
          "op": "redirect",
          "stream": "stderr",
          "target": {
            "to": "dev-null"
          },
          "do": {
            "op": "exec",
            "argv": [
              "cat",
              "/proc/sys/vm/mmap_rnd_bits"
            ]
          }
        },
        {
          "op": "exec",
          "argv": [
            "echo",
            "perm-denied(ok,root-only read)"
          ]
        }
      ]
    }
  ]
}
