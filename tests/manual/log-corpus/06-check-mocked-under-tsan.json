{
  "op": "seq",
  "steps": [
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "redirect",
        "stream": "stdout",
        "target": {
          "to": "dev-null"
        },
        "do": {
          "op": "exec",
          "argv": [
            "sysctl",
            "-w",
            "vm.mmap_rnd_bits=28"
          ]
        }
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "set to:"
      ]
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "exec",
        "argv": [
          "cat",
          "/proc/sys/vm/mmap_rnd_bits"
        ]
      }
    },
    {
      "op": "run-as",
      "as": "user",
      "name": "user",
      "do": {
        "op": "chdir",
        "dir": "/home/user/wt-130tsan",
        "do": {
          "op": "redirect",
          "stream": "both",
          "target": {
            "to": "file",
            "path": "/tmp/tsan_mock.log",
            "mode": "truncate"
          },
          "do": {
            "op": "exec",
            "argv": [
              "env",
              "TSAN_OPTIONS=halt_on_error=0 exitcode=0",
              "opam",
              "exec",
              "--switch=ocaml+tsan",
              "--",
              "dune",
              "exec",
              "lib/proj/test_mock/check_mocked.exe"
            ]
          }
        }
      }
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "redirect",
        "stream": "stdout",
        "target": {
          "to": "dev-null"
        },
        "do": {
          "op": "exec",
          "argv": [
            "sysctl",
            "-w",
            "vm.mmap_rnd_bits=32"
          ]
        }
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "restored to:"
      ]
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "exec",
        "argv": [
          "cat",
          "/proc/sys/vm/mmap_rnd_bits"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== ThreadSanitizer warnings ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "grep",
        "-c",
        "WARNING: ThreadSanitizer",
        "/tmp/tsan_mock.log"
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== result tail ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "tail",
        "-4",
        "/tmp/tsan_mock.log"
      ]
    }
  ]
}
