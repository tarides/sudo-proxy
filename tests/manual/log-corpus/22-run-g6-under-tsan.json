{
  "op": "seq",
  "steps": [
    {
      "op": "redirect",
      "stream": "stdout",
      "target": {
        "to": "file",
        "path": "/tmp/tsan.supp",
        "mode": "truncate"
      },
      "do": {
        "op": "exec",
        "argv": [
          "printf",
          "called_from_lib:libproj\\ncalled_from_lib:librocksdb\\ncalled_from_lib:libboost\\nrace:Saturn\\nrace:Domainslib\\n"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "chmod",
        "644",
        "/tmp/tsan.supp"
      ]
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "redirect",
        "stream": "stdout",
        "target": {
          "to": "dev-null"
        },
        "do": {
          "op": "exec",
          "argv": [
            "sysctl",
            "-w",
            "vm.mmap_rnd_bits=28"
          ]
        }
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "set to:"
      ]
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "exec",
        "argv": [
          "cat",
          "/proc/sys/vm/mmap_rnd_bits"
        ]
      }
    },
    {
      "op": "run-as",
      "as": "user",
      "name": "user",
      "do": {
        "op": "chdir",
        "dir": "/home/user/wt-130g6-tsan",
        "do": {
          "op": "redirect",
          "stream": "both",
          "target": {
            "to": "file",
            "path": "/tmp/g6_tsan.log",
            "mode": "truncate"
          },
          "do": {
            "op": "exec",
            "argv": [
              "env",
              "PROJ_CONF=/mnt/data/proj.conf",
              "TSAN_OPTIONS=suppressions=/tmp/tsan.supp halt_on_error=0 exitcode=0 history_size=4",
              "opam",
              "exec",
              "--switch=ocaml+tsan",
              "--",
              "dune",
              "exec",
              "lib/proj/test/concurrency.exe",
              "--",
              "test",
              "Multi-domain stress",
              "1"
            ]
          }
        }
      }
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "redirect",
        "stream": "stdout",
        "target": {
          "to": "dev-null"
        },
        "do": {
          "op": "exec",
          "argv": [
            "sysctl",
            "-w",
            "vm.mmap_rnd_bits=32"
          ]
        }
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "restored to:"
      ]
    },
    {
      "op": "run-as",
      "as": "root",
      "do": {
        "op": "exec",
        "argv": [
          "cat",
          "/proc/sys/vm/mmap_rnd_bits"
        ]
      }
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== ThreadSanitizer warnings (non-suppressed) ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "grep",
        "-c",
        "WARNING: ThreadSanitizer",
        "/tmp/g6_tsan.log"
      ]
    },
    {
      "op": "exec",
      "argv": [
        "echo",
        "=== result tail ==="
      ]
    },
    {
      "op": "exec",
      "argv": [
        "tail",
        "-12",
        "/tmp/g6_tsan.log"
      ]
    }
  ]
}
